# ============================================================================
# Dolimed / CabinetMed
# Depot limite au module htdocs/cabinetmed
# ============================================================================

# Ignorer tout le projet par defaut
/*

# Conserver les fichiers de gestion du depot
!/.gitignore
!/README.md

# Autoriser la traversee du repertoire htdocs
!/htdocs/
/htdocs/*

# Autoriser uniquement le module CabinetMed reel
!/htdocs/cabinetmed/
!/htdocs/cabinetmed/**

# ============================================================================
# Exclusions a l'interieur de CabinetMed
# ============================================================================

# Documents patients, pieces jointes et fichiers generes
**/documents/
**/document/
**/uploads/
**/upload/
**/files/
**/generated/
**/exports/
**/export/

# Repertoires temporaires, caches, sessions et journaux
**/tmp/
**/temp/
**/cache/
**/sessions/
**/logs/

# Journaux et fichiers temporaires
*.log
*.tmp
*.temp
*.cache
*.pid
*.lock

# Sauvegardes creees par les editeurs ou les administrateurs
*.save
*.bak
*.backup
*.old
*.orig
*.rej
*.swp
*.swo
*~

# Archives et exports de donnees
*.zip
*.tar
*.tgz
*.tar.gz
*.gz
*.7z
*.csv
*.tsv
*.xls
*.xlsx
*.ods

# Documents generes. Les modeles source ODT restent autorises.
*.pdf

# Configuration locale et secrets
**/.env
**/.env.*
**/*.local.php
**/config.local.php
**/secrets.php
**/credentials.php
**/*.key
**/*.pem
**/*.p12
**/*.pfx

# Fichiers des editeurs et du systeme
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db

# Couverture de tests et sorties de construction eventuelles
**/coverage/
**/build/
**/dist/

# Le SQL de structure et de migration sous htdocs/cabinetmed/sql reste suivi.
# Ne pas ajouter ici une exclusion globale sur les fichiers *.sql.

